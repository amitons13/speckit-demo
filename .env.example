# Copy to .env and fill in. NEVER commit a real key.
# OpenAI credentials are read from the environment and are never exposed via the API.
OPENAI_API_KEY=sk-your-key-here

# Model configuration (all behind config, not hard-coded in the codebase)
PIIGUARD_OPENAI_MODEL=gpt-4o-mini
PIIGUARD_OPENAI_TEMPERATURE=0
PIIGUARD_OPENAI_TIMEOUT_SECONDS=15

# Guardrail behavior
PIIGUARD_MAX_PAYLOAD_BYTES=262144
PIIGUARD_DEFAULT_REDACTION_STRATEGY=redact
